{{ ansible_managed | comment }}
# Un vhost per dominio: serve solo /mail/config-v1.1.xml, con il
# certificato del dominio (il vhost principale ha quello di ispmail_fqdn,
# che il client rifiuterebbe per autoconfig.<altro dominio>).
{% for d in ispmail_sni_domains %}

<VirtualHost *:443>
	ServerName autoconfig.{{ d.domain }}
	DocumentRoot {{ ispmail_autoconfig_root }}/{{ d.domain }}
	SSLCertificateFile {{ ispmail_sni_link_dir }}/{{ d.domain }}/fullchain.pem
	SSLCertificateKeyFile {{ ispmail_sni_link_dir }}/{{ d.domain }}/privkey.pem
	Include /etc/letsencrypt/options-ssl-apache.conf
	ErrorLog ${APACHE_LOG_DIR}/error.log
	CustomLog ${APACHE_LOG_DIR}/access.log combined
	<Directory {{ ispmail_autoconfig_root }}/{{ d.domain }}>
		Options None
		AllowOverride None
		Require all granted
	</Directory>
</VirtualHost>
{% endfor %}
