<?php
{{ ansible_managed | comment('c', prefix='// ', postfix='') }}
// Autodiscover di Outlook (formato POX, "outlook/responseschema/2006a"):
// Outlook manda in POST l'indirizzo in <EMailAddress> e riceve server,
// porte e nome utente (l'indirizzo completo, come vogliono Dovecot e
// Postfix) per {{ item.domain }}.

$email = '';
if (preg_match('#<EMailAddress>\s*([^<\s]+)\s*</EMailAddress>#i', file_get_contents('php://input') ?: '', $m)) {
    $email = $m[1];
}
// Solo indirizzi di questo dominio: il nome utente torna al client, non
// va riflesso testo arbitrario.
if (!preg_match('/^[A-Za-z0-9._%+-]+@{{ item.domain | regex_escape }}$/i', $email)) {
    $email = '';
}
$login = htmlspecialchars($email, ENT_XML1 | ENT_QUOTES, 'UTF-8');

header('Content-Type: application/xml; charset=utf-8');
echo <<<XML
<?xml version="1.0" encoding="utf-8"?>
<Autodiscover xmlns="http://schemas.microsoft.com/exchange/autodiscover/responseschema/2006">
  <Response xmlns="http://schemas.microsoft.com/exchange/autodiscover/outlook/responseschema/2006a">
    <Account>
      <AccountType>email</AccountType>
      <Action>settings</Action>
      <Protocol>
        <Type>IMAP</Type>
        <Server>{{ item.sni_hostname }}</Server>
        <Port>993</Port>
        <DomainRequired>off</DomainRequired>
        <LoginName>{$login}</LoginName>
        <SPA>off</SPA>
        <SSL>on</SSL>
        <AuthRequired>on</AuthRequired>
      </Protocol>
      <Protocol>
        <Type>SMTP</Type>
        <Server>{{ item.sni_hostname }}</Server>
        <Port>465</Port>
        <DomainRequired>off</DomainRequired>
        <LoginName>{$login}</LoginName>
        <SPA>off</SPA>
        <SSL>on</SSL>
        <AuthRequired>on</AuthRequired>
        <UsePOPAuth>off</UsePOPAuth>
        <SMTPLast>off</SMTPLast>
      </Protocol>
    </Account>
  </Response>
</Autodiscover>

XML;
