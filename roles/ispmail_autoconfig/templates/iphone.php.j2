// Un dizionario plist da un array PHP (stringhe, interi, booleani)
function plist_dict(array $kv, string $indent = '    ') {
    $out = "$indent<dict>\n";
    foreach ($kv as $k => $v) {
        $out .= "$indent  <key>" . htmlspecialchars($k, ENT_XML1) . '</key>';
        if (is_bool($v)) {
            $out .= $v ? '<true/>' : '<false/>';
        } elseif (is_int($v)) {
            $out .= "<integer>$v</integer>";
        } else {
            $out .= '<string>' . htmlspecialchars($v, ENT_XML1 | ENT_QUOTES, 'UTF-8') . '</string>';
        }
        $out .= "\n";
    }
    return $out . "$indent</dict>\n";
}

// UUID stabili per indirizzo: reinstallando, il profilo sostituisce il
// precedente invece di duplicare gli account
function uid(string $s) {
    $h = md5($s);
    return strtoupper(sprintf('%s-%s-%s-%s-%s', substr($h, 0, 8), substr($h, 8, 4), substr($h, 12, 4), substr($h, 16, 4), substr($h, 20, 12)));
}

$id = '{{ item.domain.split(".") | reverse | join(".") }}.mail.' . preg_replace('/[^a-z0-9]/', '-', $email);

$payloads = [[
    'PayloadType' => 'com.apple.mail.managed',
    'PayloadVersion' => 1,
    'PayloadIdentifier' => "$id.email",
    'PayloadUUID' => uid("$id.email"),
    'PayloadDisplayName' => "Posta $email",
    'EmailAccountDescription' => $email,
    'EmailAccountName' => $name,
    'EmailAccountType' => 'EmailTypeIMAP',
    'EmailAddress' => $email,
    'IncomingMailServerHostName' => $host,
    'IncomingMailServerPortNumber' => 993,
    'IncomingMailServerUseSSL' => true,
    'IncomingMailServerAuthentication' => 'EmailAuthPassword',
    'IncomingMailServerUsername' => $email,
    'OutgoingMailServerHostName' => $host,
    'OutgoingMailServerPortNumber' => 465,
    'OutgoingMailServerUseSSL' => true,
    'OutgoingMailServerAuthentication' => 'EmailAuthPassword',
    'OutgoingMailServerUsername' => $email,
    'OutgoingPasswordSameAsIncomingPassword' => true,
]];
{% if ispmail_autoconfig_apple_dav | bool and (item.sni_hostname == ispmail_fqdn or ispmail_webmail_sni_enabled | default(true) | bool) %}

// Rubrica e calendario su Radicale: un account per le collection
// personali e uno per quelle condivise del dominio (shared@dominio),
// entrambi con le credenziali della casella.
foreach (['personale' => $email, 'condivisa' => "shared@$domain"] as $kind => $principal) {
    $label = $kind === 'personale' ? $email : "$domain (condivisi)";
    $payloads[] = [
        'PayloadType' => 'com.apple.carddav.account',
        'PayloadVersion' => 1,
        'PayloadIdentifier' => "$id.carddav.$kind",
        'PayloadUUID' => uid("$id.carddav.$kind"),
        'PayloadDisplayName' => "Rubrica $label",
        'CardDAVAccountDescription' => "Rubrica $label",
        'CardDAVHostName' => $host,
        'CardDAVPort' => 443,
        'CardDAVUseSSL' => true,
        'CardDAVUsername' => $email,
        'CardDAVPrincipalURL' => "https://$host/radicale/$principal/",
    ];
    $payloads[] = [
        'PayloadType' => 'com.apple.caldav.account',
        'PayloadVersion' => 1,
        'PayloadIdentifier' => "$id.caldav.$kind",
        'PayloadUUID' => uid("$id.caldav.$kind"),
        'PayloadDisplayName' => "Calendario $label",
        'CalDAVAccountDescription' => "Calendario $label",
        'CalDAVHostName' => $host,
        'CalDAVPort' => 443,
        'CalDAVUseSSL' => true,
        'CalDAVUsername' => $email,
        'CalDAVPrincipalURL' => "https://$host/radicale/$principal/",
    ];
}
{% endif %}

$body = '';
foreach ($payloads as $p) {
    $body .= plist_dict($p, '      ');
}
$top = plist_dict([
    'PayloadType' => 'Configuration',
    'PayloadVersion' => 1,
    'PayloadIdentifier' => $id,
    'PayloadUUID' => uid($id),
    'PayloadDisplayName' => "Posta $email",
    'PayloadDescription' => "Configura posta{% if ispmail_autoconfig_apple_dav | bool and (item.sni_hostname == ispmail_fqdn or ispmail_webmail_sni_enabled | default(true) | bool) %}, rubrica e calendario{% endif %} di $email su $host.",
    'PayloadOrganization' => $domain,
    'PayloadRemovalDisallowed' => false,
], '  ');
// PayloadContent (l'array degli account) va dentro il dizionario principale
$top = preg_replace('#  </dict>\n$#', "    <key>PayloadContent</key>\n    <array>\n$body    </array>\n  </dict>\n", $top);

header('Content-Type: application/x-apple-aspen-config; charset=utf-8');
header('Content-Disposition: attachment; filename="' . preg_replace('/[^a-z0-9.@_-]/', '_', $email) . '.mobileconfig"');
echo '<?xml version="1.0" encoding="UTF-8"?>' . "\n";
echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">' . "\n";
echo "<plist version=\"1.0\">\n$top</plist>\n";
