{{ ansible_managed | comment }}
# Roundcube su mail.<dominio>/webmail.<dominio> con il certificato del
# dominio (vedi roles/ispmail_webmail_sni/defaults/main.yml).
{% for d in ispmail_sni_domains if d.sni_hostname != ispmail_fqdn %}

<VirtualHost *:443>
	ServerName {{ d.sni_hostname }}
	ServerAlias webmail.{{ d.domain }}
	DocumentRoot /var/lib/roundcube/public_html
	SSLCertificateFile {{ ispmail_sni_link_dir }}/{{ d.domain }}/fullchain.pem
	SSLCertificateKeyFile {{ ispmail_sni_link_dir }}/{{ d.domain }}/privkey.pem
	Include /etc/letsencrypt/options-ssl-apache.conf
	Include /etc/roundcube/apache.conf
	ErrorLog ${APACHE_LOG_DIR}/error.log
	CustomLog ${APACHE_LOG_DIR}/access.log combined
{% if ispmail_carddav_enabled | default(false) %}

	RewriteEngine On
	RewriteRule ^/radicale$ /radicale/ [R,L]
	RewriteRule ^/\.well-known/carddav$ /radicale/ [R=301,L]
	RewriteRule ^/\.well-known/caldav$ /radicale/ [R=301,L]
	<Location "/radicale/">
		ProxyPass http://127.0.0.1:5232/ retry=0
		ProxyPassReverse http://127.0.0.1:5232/
		RequestHeader set X-Script-Name /radicale
	</Location>
{% endif %}
</VirtualHost>
{% endfor %}
